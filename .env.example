# LLM プロバイダ設定（このファイルを .env にコピーして値を設定）
# .env は .gitignore 済み（コミットされない）

# --- 共通設定 ---
# プロバイダ: openai | gemini | vertex（既定・推奨） | anthropic | vllm
LLM_PROVIDER=vertex
# モデル名（省略時はプロバイダ既定を使用）
LLM_MODEL=gemini-3.5-flash
# API キー（openai / gemini / anthropic で使用。vertex は ADC 認証のため不要）
# LLM_API_KEY=your-api-key
# OpenAI 互換エンドポイントの上書き（省略時はプロバイダ既定を自動適用。通常不要）
# LLM_BASE_URL=

# --- Vertex を使う場合（既定・推奨。ADC 認証で API キー不要）---
# 事前に `gcloud auth application-default login` を実行しておく
GCP_PROJECT=your-gcp-project-id
LLM_LOCATION=global

# --- 各プロバイダの設定例（LLM_PROVIDER / LLM_MODEL / LLM_API_KEY を設定）---
# gemini    : LLM_PROVIDER=gemini    / LLM_MODEL=gemini-3.5-flash / LLM_API_KEY=<Gemini API キー>
# openai    : LLM_PROVIDER=openai    / LLM_MODEL=gpt-4.1-mini     / LLM_API_KEY=<OpenAI API キー>
# anthropic : LLM_PROVIDER=anthropic / LLM_MODEL=claude-haiku-4-5 / LLM_API_KEY=<Anthropic API キー>

# --- vLLM を使う場合（ローカル/LAN 内の OpenAI 互換サーバ。詳細は doc/setup-vllm.md）---
# サーバ本体（GPU・モデル重み）の構築・起動は別リポジトリの責務。ここは接続設定のみ。
# VLLM_MODEL は必須（未設定だと ValueError）。`curl <base_url>/models` の id を指定する。
# VLLM_* のプロバイダ固有変数で設定すると run_jury.py（複数プロバイダ実行）でも接続情報が保持される。
# VLLM_MODEL=nvidia/Gemma-4-26B-A4B-NVFP4
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=EMPTY
